{
  "name": "weft",
  "productName": "Weft",
  "version": "1.0.0",
  "description": "A sleek, local-first Markdown notes app with live preview, backlinks and a living graph of your ideas.",
  "author": "OrangeBubly",
  "homepage": "https://github.com/OrangeBubly/weft",
  "repository": {
    "type": "git",
    "url": "https://github.com/OrangeBubly/weft.git"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "build:editor": "esbuild src/editor.js --bundle --minify --format=iife --outfile=renderer/editor.bundle.js --log-level=warning",
    "prestart": "npm run build:editor",
    "start": "electron .",
    "dist": "npm run build:editor && electron-builder --publish never",
    "dist:win": "npm run build:editor && electron-builder --win --publish never",
    "dist:mac": "npm run build:editor && electron-builder --mac --publish never",
    "dist:linux": "npm run build:editor && electron-builder --linux --publish never"
  },
  "dependencies": {
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.4",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.2",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "io.github.orangebubly.weft",
    "productName": "Weft",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Weft",
      "artifactName": "Weft-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "Weft-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Office",
      "artifactName": "Weft-${version}-linux-${arch}.${ext}"
    }
  }
}
